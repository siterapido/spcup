DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
OPENROUTER_API_KEY=
# Extrato PDF (visão). Default: google/gemini-3.5-flash (PDF nativo, json_schema)
OPENROUTER_PDF_MODEL=google/gemini-3.5-flash
# Match movimentação ↔ cadastro. Default: google/gemini-3.5-flash
OPENROUTER_MODEL=google/gemini-3.5-flash
# Rollback Kimi: OPENROUTER_PDF_MODEL=moonshotai/kimi-k2.6 (+ mistral-ocr automático)
# Comprovante PDF único (legado extractStructuredFromPdf): anthropic/claude-sonnet-4 se OPENROUTER_MODEL não setado no call
# Cache local de extrações por hash do arquivo (0 = desliga)
OPENROUTER_CACHE=1
# Timeout PDF visão em ms (por lote/página)
OPENROUTER_PDF_TIMEOUT_MS=180000
# Páginas por chamada OpenRouter (1 = uma página por request, recomendado Kimi)
OPENROUTER_PDF_PAGES_PER_BATCH=1
# Força lote se PDF >= N bytes mesmo com 1 página
OPENROUTER_PDF_SPLIT_MIN_BYTES=200000
# Limite de páginas por arquivo
MAX_EXTRATO_PAGES=12
# OPENROUTER_MAX_TOKENS=8192
AUTH_SECRET=
AUTH_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STORAGE_ROOT=./data/uploads
