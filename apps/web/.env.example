# Neon Postgres (required)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (upload route)
BLOB_READ_WRITE_TOKEN=

# OpenRouter (PDF extraction + match IA)
OPENROUTER_API_KEY=
# Match IA (movimentações). Não é usado para extração de PDF.
OPENROUTER_MODEL=moonshotai/kimi-k2.6
# Extrato PDF apenas (default anthropic/claude-sonnet-4 se vazio)
OPENROUTER_PDF_MODEL=

# Auth.js v5 (required)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Seed script (scripts/seed-admin.ts)
ADMIN_EMAIL=admin@spcup.com.br
ADMIN_PASSWORD=

# Local file storage (ingest / XML export paths)
STORAGE_ROOT=./data/uploads

# Optional: confidence threshold for auto-confirm in match
CONFIANCA_LIMIAR_ALTA=0.85

# Optional: skip XSD when xmllint unavailable (CI)
# SPC_SKIP_XSD_VALIDATION=1
