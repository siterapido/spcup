# Neon Postgres (required)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (upload route)
BLOB_READ_WRITE_TOKEN=

# OpenRouter (PDF extraction + match IA)
OPENROUTER_API_KEY=
# Match IA (movimentações). Default: google/gemini-3.5-flash
OPENROUTER_MODEL=google/gemini-3.5-flash
# Extrato PDF (visão). Default: google/gemini-3.5-flash. Kimi: moonshotai/kimi-k2.6
OPENROUTER_PDF_MODEL=google/gemini-3.5-flash
# Dual-extract: segundo passe (consenso). none = desligado (economiza tokens).
OPENROUTER_MODEL_SECONDARY=none
# Revisor de divergências (default no código: gemini-3.5-flash)
OPENROUTER_MODEL_REVIEWER=google/gemini-3.5-flash
# Cap máximo de tokens de saída por chamada OpenRouter (default no código: 8192)
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_SCORE_MAX_TOKENS=1024

# Dev server (3000 costuma estar ocupada por outros apps)
PORT=3002

# Auth.js v5 (required)
AUTH_SECRET=
AUTH_URL=http://localhost:3002

# Seed script (scripts/seed-admin.ts)
ADMIN_EMAIL=admin@spcup.com.br
ADMIN_PASSWORD=

# Local file storage (ingest / XML export paths)
STORAGE_ROOT=./data/uploads

# Optional: confidence threshold for auto-confirm in match
CONFIANCA_LIMIAR_ALTA=0.85

# Optional: skip XSD when xmllint unavailable (CI)
# SPC_SKIP_XSD_VALIDATION=1
